{
  "manifest_version": 3,
  "name": "MovieTrack",
  "version": "0.1.0",
  "description": "Track anime and movie watching activity from tab metadata (title + URL).",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MovieTrack",
    "default_popup": "popup.html"
  }
}
